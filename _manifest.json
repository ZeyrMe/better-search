{
  "manifest_version": 2,
  "id": "zeyr.better-search",
  "version": "0.1.0",
  "name": "更好的搜索",
  "description": "多引擎搜索与正文抓取",
  "author": {
    "name": "zeyr",
    "url": "https://github.com/zeyr"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/zeyr/better-search"
  },
  "host_application": {
    "min_version": "1.4.8",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": "<1,>=0.28"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": "<5,>=4.13"
    }
  ],
  "capabilities": [
    "api.get",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "chat"
}
