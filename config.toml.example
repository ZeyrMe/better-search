# Generated from config_models.py; instance config.toml stays local.
show_advanced = false
enabled = true
backends = []
sources = []
preferred_domains = []
domain_routes = []
timeout_seconds = 8.0
max_results = 5
cache_minutes = 30
max_cache_entries = 128
max_body_chars = 12000
max_response_bytes = 2000000
user_agent = "zeyr-better-search/0.1"

[scope]
mode = "all"
groups = []
privates = []
users = []
exclude = []
allow_private = true
reference_cache_seconds = 60
api_timeout_seconds = 0.4
max_tracked_streams = 256

[plugin]
config_version = "0.1.0"

[[channels]]
name = "general"
desc = "查网页资料、百科知识与近期动态"
auto_attach = false
sites = []
backends = []
time_range = "any"
lang = ""
region = ""

[reader_fallback]
enabled = false
url_prefix = ""
min_chars = 100

[passive_peek]
enabled = false
trigger = "url"
model_task = ""
cooldown_seconds = 600
max_chars = 500
max_pending = 4
timeout_seconds = 45
instruction = "看看这段对话里有没有提到大家可能不太熟的新梗、刚出的作品或具体新闻。需要查一下背景就返回 JSON {\"query\":\"搜索词\"}，不需要就返回 {\"query\":\"\"}。对话："

[[default_sources]]
name = "duckduckgo"
kind = "duckduckgo"
endpoint = "https://html.duckduckgo.com/html/?q={query}"
api_key = ""
headers = []
domains = []
scopes = []
enabled = true

[[default_sources]]
name = "bing"
kind = "bing"
endpoint = "https://www.bing.com/search?q={query}"
api_key = ""
headers = []
domains = []
scopes = []
enabled = true
